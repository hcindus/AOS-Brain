[Unit]
Description=OrderPort — multi-tenant online ordering SaaS
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/.openclaw/workspace/orderport/backend
Environment="ORDERPORT_PORT=8088"
Environment="ORDERPORT_BASE_URL=https://psdepot.com"
Environment="ORDERPORT_SECRET=CHANGE_ME"
Environment="STRIPE_SECRET_KEY="
Environment="STRIPE_PUBLISHABLE_KEY="
Environment="SMTP_HOST=smtp.hostinger.com"
Environment="SMTP_PORT=587"
Environment="SMTP_USER=miles@myl0nr0s.cloud"
Environment="SMTP_PASS="
Environment="TWILIO_ACCOUNT_SID="
Environment="TWILIO_AUTH_TOKEN="
Environment="TWILIO_FROM="
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 127.0.0.1 --port 8088
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
