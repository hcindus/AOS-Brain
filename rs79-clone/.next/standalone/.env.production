# RS-79 POS System - Production Environment Template
# Copy to .env.local and fill in actual values for production deployment

# Database
DATABASE_URL=postgresql://rs79:CHANGE_ME@postgres:5432/rs79?schema=public

# Application
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Security - MUST be changed in production
NEXTAUTH_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_SECRET=CHANGE_ME_IN_PRODUCTION

# URLs
NEXTAUTH_URL=https://your-domain.com

# Session
SESSION_MAX_AGE=86400
