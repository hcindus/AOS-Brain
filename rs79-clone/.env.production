# RS-79 POS System - Production Environment
# This file is committed as a template - copy to .env.local for actual deployment

# Database - will be overridden by actual deployment
DATABASE_URL=postgresql://rs79:${POSTGRES_PASSWORD}@postgres:5432/rs79?schema=public

# Application
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Security - MUST be overridden in production
NEXTAUTH_SECRET=${NEXTAUTH_SECRET}
JWT_SECRET=${JWT_SECRET}

# URLs
NEXTAUTH_URL=${NEXTAUTH_URL}

# Session
SESSION_MAX_AGE=86400