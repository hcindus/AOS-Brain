# RS-79 POS System - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
# For Docker: postgresql://user:pass@postgres:5432/dbname?schema=public
# For VPS direct: postgresql://user:pass@localhost:5432/dbname?schema=public
DATABASE_URL=postgresql://rs79:changeme@localhost:5432/rs79?schema=public

# PostgreSQL Credentials (used by docker-compose)
POSTGRES_USER=rs79
POSTGRES_PASSWORD=changeme-strong-password
POSTGRES_DB=rs79

# ============================================
# Application Configuration
# ============================================
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# ============================================
# Security - CHANGE THESE IN PRODUCTION!
# ============================================
# Generate strong secrets with: openssl rand -base64 32
NEXTAUTH_SECRET=your-super-secret-key-change-this-in-production
JWT_SECRET=your-jwt-secret-change-this-in-production

# Session configuration
SESSION_MAX_AGE=86400

# ============================================
# URLs
# ============================================
# Public URL where the app will be accessed
NEXTAUTH_URL=https://pos.yourdomain.com

# ============================================
# Optional: External Services
# ============================================
# Redis (for session caching)
# REDIS_URL=redis://localhost:6379

# Email/SMTP (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Optional: Payment processor keys (if integrating)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: Crypto payment processor
# COINBASE_API_KEY=...

# ============================================
# Monitoring (Optional)
# ============================================
# SENTRY_DSN=https://...
# LOG_LEVEL=info