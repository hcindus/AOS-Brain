[Unit]
Description=Performance Supply Depot — Frontline SOA (Service Oriented Assistant)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/.openclaw/workspace/front-desk
EnvironmentFile=/root/.openclaw/workspace/aocros/secrets/telegram.env
Environment=FRONTLINE_PORT=8120
Environment=LLM_BASE_URL=http://127.0.0.1:11434/v1
Environment=LLM_MODEL=antoniohudnall/Mort_II:latest
ExecStart=/usr/bin/python3 /root/.openclaw/workspace/front-desk/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
