# Database
DATABASE_URL=./data/auth.db

# JWT Secrets (generate strong random strings)
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:8080

# Redis (for rate limiting in production)
REDIS_URL=redis://localhost:6379

# Security
BCRYPT_PEPPER=your-pepper-secret-min-32-chars
SESSION_TIMEOUT=900000
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900000

# Email (for password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@yourdomain.com

# Logging
LOG_LEVEL=info
AUDIT_LOG_PATH=./logs/audit.log