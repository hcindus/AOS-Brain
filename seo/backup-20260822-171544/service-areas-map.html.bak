  ["Denver", 39.7, -105.0, "/denver-spanish.html", 5],
  ["Detroit", 42.3, -83.0, "/detroit-spanish.html", 5],
  ["Filadelfia", 40.0, -75.2, "/filadelfia-spanish.html", 5],
  ["Houston", 29.8, -95.4, "/houston-spanish.html", 5],
  ["Kansas City", 39.1, -94.6, "/kansas-city-spanish.html", 5],
  ["Las Vegas", 36.2, -115.1, "/las-vegas-spanish.html", 5],
  ["Los Ángeles", 34.05, -118.24, "/los-angeles-spanish.html", 5],
  ["Miami", 25.8, -80.2, "/miami-spanish.html", 5],
  ["Mineápolis", 45.0, -93.3, "/minneapolis-spanish.html", 5],
  ["Nashville", 36.2, -86.8, "/nashville-spanish.html", 5],
  ["Nueva Orleans", 30.0, -90.1, "/nueva-orleans-spanish.html", 5],
  ["Phoenix", 33.4, -112.1, "/phoenix-spanish.html", 5],
  ["San Francisco", 37.8, -122.4, "/san-francisco-spanish.html", 5],
  ["Seattle", 47.6, -122.3, "/seattle-spanish.html", 5]
];
spanishPlaces.forEach(function(p){
  L.circleMarker([p[1], p[2]], {radius:p[4], color:"#b45309", weight:1.5, fillColor:"#f59e0b", fillOpacity:0.85}).bindPopup('<b>'+p[0]+'</b> (Español)<br><a href="'+p[3]+'">Ver &rarr;</a>').addTo(spanishLayer);
});

var overlay = {
  "Countries": countriesLayer,
  "States &amp; Provinces": statesLayer,
  "Cities": citiesLayer,
  "Español": spanishLayer
};
L.control.layers(null, overlay, { collapsed:false }).addTo(map);
</script>
</body>
</html>
