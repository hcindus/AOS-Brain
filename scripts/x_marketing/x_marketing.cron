# X Marketing Cron Jobs for Performance Supply Depot
# Generates daily tweet content in EN/ES/ZH with 888-881-6834

# Generate daily content at 9 AM, 1 PM, and 5 PM PST (12 PM, 4 PM, 8 PM UTC)
0 12 * * * root cd /root/.openclaw/workspace/scripts/x_marketing && /usr/bin/python3 x_content.py daily >> /var/log/x_marketing.log 2>&1

# Backup: Single random tweets throughout the day
0 15 * * * root cd /root/.openclaw/workspace/scripts/x_marketing && /usr/bin/python3 x_content.py en >> /var/log/x_marketing.log 2>&1
0 18 * * * root cd /root/.openclaw/workspace/scripts/x_marketing && /usr/bin/python3 x_content.py es >> /var/log/x_marketing.log 2>&1
0 21 * * * root cd /root/.openclaw/workspace/scripts/x_marketing && /usr/bin/python3 x_content.py zh >> /var/log/x_marketing.log 2>&1
