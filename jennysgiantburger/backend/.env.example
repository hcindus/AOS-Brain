# Jenny's Giant Burger — Ordering Backend config
# Copy to .env and fill in real values.

# --- Business ---
JENNY_BUSINESS_NAME=Jenny's Giant Burger
JENNY_BUSINESS_PHONE=(707) 964-2235
JENNY_BUSINESS_ADDRESS=940 Main St N, Fort Bragg, CA 95437
JENNY_TAX_RATE=0.0875

# --- Twilio SMS (kitchen order + customer receipt) ---
# Get these from console.twilio.com — a phone-number-capable account.
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+15551234567

# --- Kitchen / cook's device (receives order SMS) ---
JENNY_COOK_PHONE=+17075550123

# --- Runtime ---
JENNY_PORT=8089
JENNY_DATA_DIR=/var/lib/jennysgiantburger
